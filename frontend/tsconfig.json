{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    // ▼ Honoのパス解決を強制する設定
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "hono": [
        "./node_modules/hono"
      ],
      "hono/*": [
        "./node_modules/hono/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
    // ❌ ここにあった "../backend/src/**/*.ts" は削除しました
  ],
  "exclude": [
    "node_modules",
    "../backend" // ▼ 念のため明示的に除外に追加
  ]
}